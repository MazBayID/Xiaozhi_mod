{
    "type": "huy-vector-c3",
    "target": "esp32c3",
    "builds": [
        {
            "name": "huy-vector-c3",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y",
                "CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/4m.csv\"",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_USE_ESP_WAKE_WORD=y"
            ]
        }
    ]
}
